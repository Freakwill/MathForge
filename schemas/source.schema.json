{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "kind": {
      "enum": [
        "published_paper",
        "researcher_preprint",
        "monograph",
        "survey",
        "official_problem_list",
        "expert_discussion",
        "secondary",
        "informal",
        "unsourced"
      ]
    },
    "access": {
      "enum": [
        "full_text",
        "landing_page",
        "abstract",
        "search_only",
        "unavailable"
      ]
    },
    "retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "publication_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1500,
      "maximum": 2100
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "recorded_at",
        "method",
        "limitations"
      ],
      "additionalProperties": false
    },
    "status_bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^MF-[0-9]{4}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "statement_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement_sha256",
          "locator"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_id",
    "title",
    "authors",
    "url",
    "kind",
    "access",
    "retrieved_on",
    "publication_year",
    "version",
    "provenance",
    "status_bindings"
  ],
  "additionalProperties": false
}
