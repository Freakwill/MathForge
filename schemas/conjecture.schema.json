{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conjecture_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "motivation": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "weakest_useful_formulation": {
      "type": "string",
      "minLength": 1
    },
    "falsification_route": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "enum": [
              "statement",
              "open_status",
              "known_result",
              "motivation",
              "conflict"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator",
          "supports",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "recorded_at",
        "method",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "conjecture_id",
    "problem_id",
    "statement",
    "motivation",
    "scope",
    "weakest_useful_formulation",
    "falsification_route",
    "evidence",
    "provenance"
  ],
  "additionalProperties": false
}
