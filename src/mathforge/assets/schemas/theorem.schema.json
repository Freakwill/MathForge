{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "theorem_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proof_kind": {
      "enum": [
        "lean",
        "deterministic_formal_verifier",
        "established_primary_citation"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "enum": [
              "statement",
              "open_status",
              "known_result",
              "motivation",
              "conflict"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator",
          "supports",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "recorded_at",
        "method",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "theorem_id",
    "problem_id",
    "statement",
    "hypotheses",
    "proof_kind",
    "evidence",
    "artifact_path",
    "artifact_sha256",
    "verifier_version",
    "axioms",
    "provenance"
  ],
  "additionalProperties": false
}
